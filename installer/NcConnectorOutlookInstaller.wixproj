<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>NCConnectorForOutlook</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>

    <BuildOutputDir Condition=" '$(BuildOutputDir)' == '' ">$(MSBuildProjectDirectory)\..\src\NcTalkOutlookAddIn\bin\Release\</BuildOutputDir>
    <ProductVersion Condition=" '$(ProductVersion)' == '' ">3.4.1</ProductVersion>
    <AssemblyVersion Condition=" '$(AssemblyVersion)' == '' ">3.4.1.0</AssemblyVersion>

    <IfbCleanupExe>$(MSBuildProjectDirectory)\IfbCleanup\bin\$(Configuration)\NcConnectorIfbCleanup.exe</IfbCleanupExe>
    <DefineConstants>BuildOutputDir=$(BuildOutputDir);ProductVersion=$(ProductVersion);AssemblyVersion=$(AssemblyVersion);IfbCleanupExe=$(IfbCleanupExe)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Http.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>

